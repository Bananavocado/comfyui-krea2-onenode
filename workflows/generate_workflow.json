{
  "K2:unet": {
    "inputs": {
      "unet_name": "krea2_turbo_bf16.safetensors",
      "weight_dtype": "default"
    },
    "class_type": "UNETLoader",
    "_meta": { "title": "Load Diffusion Model" }
  },
  "K2:lora": {
    "inputs": {
      "model": ["K2:unet", 0]
    },
    "class_type": "Power Lora Loader (rgthree)",
    "_meta": { "title": "LoRA Stack" }
  },
  "K2:clip": {
    "inputs": {
      "clip_name": "qwen3vl_4b_fp8_scaled.safetensors",
      "type": "krea2",
      "device": "default"
    },
    "class_type": "CLIPLoader",
    "_meta": { "title": "Load CLIP" }
  },
  "K2:pos": {
    "inputs": {
      "text": "",
      "clip": ["K2:clip", 0]
    },
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Prompt" }
  },
  "K2:zero": {
    "inputs": {
      "conditioning": ["K2:pos", 0]
    },
    "class_type": "ConditioningZeroOut",
    "_meta": { "title": "Zero Negative (pass 1)" }
  },
  "K2:latent": {
    "inputs": {
      "width": 1024,
      "height": 576,
      "batch_size": 1
    },
    "class_type": "EmptyLatentImage",
    "_meta": { "title": "Empty Latent (Base)" }
  },
  "K2:seed": {
    "inputs": {
      "seed": 703028258219895
    },
    "class_type": "Seed (rgthree)",
    "_meta": { "title": "Seed" }
  },
  "K2:sampler1": {
    "inputs": {
      "add_noise": "enable",
      "noise_seed": ["K2:seed", 0],
      "steps": 8,
      "cfg": 1,
      "sampler_name": "euler",
      "scheduler": "simple",
      "start_at_step": 0,
      "end_at_step": 8,
      "return_with_leftover_noise": "enable",
      "model": ["K2:lora", 0],
      "positive": ["K2:pos", 0],
      "negative": ["K2:zero", 0],
      "latent_image": ["K2:latent", 0]
    },
    "class_type": "KSamplerAdvanced",
    "_meta": { "title": "Sampler Pass 1 (base)" }
  },
  "K2:upscale": {
    "inputs": {
      "upscale_method": "bislerp",
      "scale_by": 1.8,
      "samples": ["K2:sampler1", 0]
    },
    "class_type": "LatentUpscaleBy",
    "_meta": { "title": "Latent Upscale" }
  },
  "K2:sampler2": {
    "inputs": {
      "add_noise": "disable",
      "noise_seed": ["K2:seed", 0],
      "steps": 10,
      "cfg": 0.8,
      "sampler_name": "dpmpp_2m_sde",
      "scheduler": "sgm_uniform",
      "start_at_step": 5,
      "end_at_step": 999,
      "return_with_leftover_noise": "disable",
      "model": ["K2:lora", 0],
      "positive": ["K2:pos", 0],
      "negative": ["K2:pos", 0],
      "latent_image": ["K2:upscale", 0]
    },
    "class_type": "KSamplerAdvanced",
    "_meta": { "title": "Sampler Pass 2 (hi-res refine)" }
  },
  "K2:vae": {
    "inputs": {
      "vae_name": "qwen_image_vae.safetensors"
    },
    "class_type": "VAELoader",
    "_meta": { "title": "Load VAE" }
  },
  "K2:decode": {
    "inputs": {
      "samples": ["K2:sampler2", 0],
      "vae": ["K2:vae", 0]
    },
    "class_type": "VAEDecode",
    "_meta": { "title": "VAE Decode" }
  },
  "K2:save": {
    "inputs": {
      "filename_prefix": "krea2-onenode/Krea2",
      "images": ["K2:decode", 0]
    },
    "class_type": "SaveImage",
    "_meta": { "title": "Save Image" }
  }
}
